# --- Jira Cloud ---
JIRA_BASE_URL=https://votre-domaine.atlassian.net
JIRA_EMAIL=vous@entreprise.com
# Jeton API : https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Modèles (format "fournisseur:modèle") ---
ANTHROPIC_API_KEY=
MODEL=anthropic:claude-sonnet-5-5
# Optionnel : un modèle différent par rôle (ex. plus costaud pour la relecture)
# SPEC_MODEL=
# DEV_MODEL=
# REVIEW_MODEL=

# --- Dépôt cible : là où l'agent 2 écrira le code et les tests ---
TARGET_REPO=../mon-projet
# Vérifications déterministes du harnais (quality gates) — fortement recommandé
# Ex. Angular : npx ng test --watch=false --browsers=ChromeHeadless
# Ex. Spring  : ./mvnw -q test
TEST_COMMAND=
# Ex. Angular : npx ng lint        Ex. Spring : ./mvnw -q checkstyle:check
LINT_COMMAND=

# --- Sorties (spec, rapport, trace, métriques, état) ---
OUT_DIR=out

# --- Réglages du harnais (valeurs par défaut indiquées) ---
# MAX_ROUNDS=3              # tours développeur -> vérifications -> relecteur
# MAX_TOOL_CALLS=80         # appels d'outils max par tour du développeur
# MAX_MODEL_CALLS=60        # appels modèle max par agent et par tour
# RECURSION_LIMIT=150
# COMMAND_TIMEOUT_MS=300000
# COMPACTION_TOKENS=60000   # seuil de résumé automatique de l'historique
# MAX_FILES=25              # fichiers distincts écrits max par run
# MAX_FILE_BYTES=200000
# STRICT_SCOPE=false        # true : n'écrire que les fichiers de la spec (+ tests)
# WRITE_DENY=               # globs supplémentaires interdits en écriture, séparés par des virgules
